# Banco de dados Supabase — COMPARTILHADO com o projeto CRMNovaAcropole.
# DATABASE_URL: "Transaction pooler" (porta 6543) — usada em runtime pelo
# app (compatível com ambiente serverless/Vercel).
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres"
# DIRECT_DATABASE_URL: "Session pooler" (porta 5432) — só pra
# migrations/introspecção via Prisma CLI (a transaction pooler trava
# nesses comandos; a conexão direta pura pode exigir IPv6).
DIRECT_DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"

# Supabase (Auth + client) — mesmo projeto do CRMNovaAcropole
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Chave que decifra as credenciais do scraper (Mercúrio/Ulisses) salvas no
# Supabase acima — mesma usada no CRMNovaAcropole.
CREDENCIAIS_SCRAPER_CHAVE=""

# Asaas (gateway de pagamento / PIX)
ASAAS_API_KEY=""
ASAAS_ENV="sandbox" # sandbox | production

# WhatsApp (provedor inicial, ex: Z-API)
WHATSAPP_PROVIDER_TOKEN=""
WHATSAPP_PROVIDER_INSTANCE=""
